#include <windows.h>
#include <version.h>

//
// TO_STRING is a utility macro that converts a macro into a string.
//
#define TO_STRING_IMPL(s) #s
#define TO_STRING(s) TO_STRING_IMPL(s)


//
// VERSIONINFO
//

VS_VERSION_INFO VERSIONINFO
 FILEVERSION FLUTTER_VERSION_MAJOR,FLUTTER_VERSION_MINOR,FLUTTER_VERSION_PATCH,FLUTTER_VERSION_BUILD
 PRODUCTVERSION FLUTTER_VERSION_MAJOR,FLUTTER_VERSION_MINOR,FLUTTER_VERSION_PATCH,FLUTTER_VERSION_BUILD
 FILEFLAGSMASK 0x17L
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904e4"
        BEGIN
            VALUE "CompanyName", "com.powersoft" "\0"
            VALUE "FileDescription", "Washio" "\0"
            VALUE "FileVersion", TO_STRING(FLUTTER_VERSION)
            VALUE "InternalName", "Washio" "\0"
            VALUE "LegalCopyright", "Copyright (c) 2024 com.powersoft. All rights reserved." "\0"
            VALUE "OriginalFilename", "Washio.exe" "\0"
            VALUE "ProductName", "Washio" "\0"
            VALUE "ProductVersion", TO_STRING(FLUTTER_VERSION)
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END


//
// Icon
//

// The app icon.
IDI_APP_ICON ICON "icons/app_icon.ico"
